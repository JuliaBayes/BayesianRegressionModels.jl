# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# Auto-generated HTMXObjects recording outputs — not committed to main
docs/src/public/live-*/

# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest*.toml
!scripts/render_env/Manifest.toml

# Reproducible develop-path checkouts materialized by test/setup_env.jl.
test/.bootstrap/

# Reproducible plotting checkouts materialized by
# research/radon_centering/plots/setup_plots_env.sh.
research/radon_centering/plots/.bootstrap/

# Scratch dir for BridgeStan probe artifacts (.stan sources + compiled _model.so).
# Regenerated on demand and host-specific; 22 of these were committed by mistake
# in 2ffac3c and had to be untracked again in 9d55b60.
tmp/
*_model.so

# File generated by the Preferences package to store local preferences
LocalPreferences.toml
JuliaLocalPreferences.toml

# Confidential client-project extensions (local-only, never commit): each
# `<prefix>-ext.jl` registers a dataset + allowlist for its `<prefix>-*` examples.
web-macro/src/*-ext.jl
# Confidential client-project example data (local-only, never commit). These
# match the local example filenames directly; see the pending naming decision.
web-macro/examples/bruno-*.jl
web-macro/examples/bordet-*.jl

# Large fit-artifact archives and serialized draws — never commit these
# (snag brm-binaries-in-93881f23). Raw-fit tarballs are produced by
# research/archive_total_study.py et al. into a results/ tree; keep them in
# the producing run's scratch / artifact store, not in git history: they are
# incompressible, so every version pays full packfile weight in every clone.
# The in-tree manifest.json files remain the hash authority for archives
# published before the untracking commit (see research/ARCHIVED_FITS.md).
# Docs example inputs stay vendored (docs/examples/*.jl read them from the
# checkout); only NEW compressed archives are blocked there.
research/**/*.tar.gz
research/**/*.jls
research/**/*.jls.gz
research/**/*.csv.gz
docs/**/*.csv.gz
